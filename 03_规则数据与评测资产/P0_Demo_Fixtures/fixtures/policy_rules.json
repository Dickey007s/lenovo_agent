  "device_rules": [
    {
      "rule_id": "mobile_l3_plus_enhanced_confirm",
      "condition": {
        "device_type": "mobile",
        "risk_gte": "L3"
      },
      "effect": "enhance_confirmation",
      "reason_code": "MOBILE_CONTEXT"
    },
    {
      "rule_id": "public_network_sensitive_mask",
      "condition": {
        "network": "public_wifi",
        "data_classes_any": [
          "pricing",
          "financial",
          "contract",
          "hr",
          "credential"
        ]
      },
      "effect": "mask_and_confirm",
      "reason_code": "PUBLIC_NETWORK"
    }
  ],
  "hard_rules": [
    {
      "rule_id": "external_send_requires_l4",
      "if": {
        "action_type": "send_email_external"
      },
      "risk_floor": "L4",
      "decision": "risk_lens_strong_confirm",
      "reason_code": "EXTERNAL_SEND"
    },
    {
      "rule_id": "pricing_commitment_forbidden",
      "if": {
        "action_type": "commit_pricing_terms"
      },
      "risk_floor": "L5",
      "decision": "reject_to_manual",
      "reason_code": "PRICING_COMMITMENT"
    },
    {
      "rule_id": "payment_forbidden",
      "if": {
        "action_type": "make_payment"
      },
      "risk_floor": "L5",
      "decision": "reject_to_manual",
      "reason_code": "PAYMENT_RESTRICTED"
    },
    {
      "rule_id": "contract_sign_forbidden",
      "if": {
        "action_type": "sign_contract"
      },
      "risk_floor": "L5",
      "decision": "reject_to_manual",
      "reason_code": "CONTRACT_LEGAL_COMMITMENT"
    },
    {
      "rule_id": "permission_change_forbidden",
      "if": {
        "action_type": "change_permission"
      },
      "risk_floor": "L5",
      "decision": "reject_to_manual",
      "reason_code": "PERMISSION_CHANGE"
    },
    {
      "rule_id": "credential_never_to_model",
      "if": {
        "data_classes_contains": "credential"
      },
      "risk_floor": "L5",
      "decision": "block_and_mask",
      "reason_code": "CREDENTIAL_NEVER_TO_MODEL"
    },
    {
      "rule_id": "suspected_prompt_injection_suspend",
      "if": {
        "data_classes_contains": "prompt_injection_suspected"
      },
      "risk_floor": "L4",
      "decision": "suspend_and_review",
      "reason_code": "PROMPT_INJECTION_SUSPECTED"
    },
    {
      "rule_id": "missing_critical_slot_clarify",
      "if": {
        "missing_slots_intersects": "critical_slots"
      },
      "risk_floor": "L3",
      "decision": "clarify_before_action",
      "reason_code": "MISSING_CRITICAL_SLOT"
    }
  ],
