{
  "meta": {
    "name": "office_agent_p0_policy_rules",
    "version": "0.1.0",
    "generated_at": "2026-06-04",
    "usage": "P0 Demo fixture，用于 Risk Engine 查表和 Human Gate 映射；不代表真实企业策略。"
  },
  "risk_order": [
    "L0",
    "L1",
    "L2",
    "L3",
    "L4",
    "L5"
  ],
  "risk_levels": {
    "L0": "无业务影响：后台同步、索引、只读状态更新。",
    "L1": "低风险可逆：仅个人可见、可撤销、影响范围小。",
    "L2": "中低风险：摘要、草稿、提取信息，不外发、不提交。",
    "L3": "中风险内部动作：改变内部系统状态或写入草稿区，需预览确认。",
    "L4": "高风险外部/敏感动作：外发、审批、CRM/OA状态变更、财务/客户/报价等。",
    "L5": "极高风险/受限动作：付款、合同签署、权限变更、价格承诺、HR敏感动作、不可逆批量操作。"
  },
  "autonomy_levels": {
    "AL0": "人工驾驶：Agent 不执行，只给人工流程入口。",
    "AL1": "建议导航：Agent 提醒和解释风险，不执行动作。",
    "AL2": "副驾草稿：Agent 生成草稿、摘要或模拟结果。",
    "AL3": "监督执行：用户确认后，Agent 才能模拟执行/调用工具。",
    "AL4": "可撤销自动：低风险动作自动执行，并提供撤销入口。",
    "AL5": "后台自动：无业务影响的后台维护，不打扰用户。"
  },
