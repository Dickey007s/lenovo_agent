        "rule_id": "SEG-CLEAN-DUPLICATE",
        "category": "cleaning",
        "source_file_ref": "forte-8d86fcca3891dabb",
        "locator": "客户分类画像与差异化销售策略生成规则.md:L8",
        "excerpt": "1. 剔除重复样本，仅保留重复样本中的第一条",
        "parameters": [
          "policy_assumption=exact_non_id_payload"
        ]
      },
      {
        "rule_id": "SEG-CLEAN-CHINESE",
        "category": "cleaning",
        "source_file_ref": "forte-8d86fcca3891dabb",
        "locator": "客户分类画像与差异化销售策略生成规则.md:L9",
        "excerpt": "2. 将非数字格式的评分字段转换为对应数字（例如将「一」转换为「1」）",
        "parameters": [
          "mapping=零..十",
          "range=0..10"
        ]
      },
      {
        "rule_id": "SEG-CLEAN-MISSING",
        "category": "cleaning",
        "source_file_ref": "forte-8d86fcca3891dabb",
        "locator": "客户分类画像与差异化销售策略生成规则.md:L10",
        "excerpt": "3. 缺失的评分字段统一按数值0处理",
        "parameters": [
          "default=0"
        ]
      },
      {
        "rule_id": "SEG-PROFILE-TECH",
        "category": "classification",
        "source_file_ref": "forte-8d86fcca3891dabb",
        "locator": "客户分类画像与差异化销售策略生成规则.md:L15",
        "excerpt": "1. 技术型：专业(Stech)字段数值≥8的客户",
        "parameters": [
          "threshold=8"
        ]
      },
      {
        "rule_id": "SEG-PROFILE-SAFE",
        "category": "classification",
        "source_file_ref": "forte-8d86fcca3891dabb",
        "locator": "客户分类画像与差异化销售策略生成规则.md:L16",
        "excerpt": "2. 安全型：安全(Ssafe)字段 **和** 预算(Sbudget)字段数值同时≥8的客户",
        "parameters": [
          "threshold=8",
          "fields=safe+budget"
        ]
      },
      {
        "rule_id": "SEG-PROFILE-AGILE",
        "category": "classification",
        "source_file_ref": "forte-8d86fcca3891dabb",
        "locator": "客户分类画像与差异化销售策略生成规则.md:L17",
        "excerpt": "3. 敏捷型：易用(Seasy)字段数值≥8的客户",
        "parameters": [
          "threshold=8"
        ]
      },
      {
        "rule_id": "SEG-PRIORITY",
        "category": "priority",
        "source_file_ref": "forte-8d86fcca3891dabb",
        "locator": "客户分类画像与差异化销售策略生成规则.md:L20",
        "excerpt": "若某客户同时满足多个画像条件，按以下优先级取唯一标签：`技术型 > 安全型 > 敏捷型`，最终输出剔除所有无法归类的样本数据",
        "parameters": [
          "order=技术型 > 安全型 > 敏捷型"
        ]
      },
      {
        "rule_id": "SEG-EXCLUDE",
        "category": "exclusion",
        "source_file_ref": "forte-8d86fcca3891dabb",
        "locator": "客户分类画像与差异化销售策略生成规则.md:L20",
        "excerpt": "若某客户同时满足多个画像条件，按以下优先级取唯一标签：`技术型 > 安全型 > 敏捷型`，最终输出剔除所有无法归类的样本数据",
        "parameters": [
          "unclassified=exclude"
        ]
      },
